--cpu=Cortex-M4.fp.sp
"stm32_2_switch\startup_stm32f401xc.o"
"stm32_2_switch\main.o"
"stm32_2_switch\stm32f4xx_it.o"
"stm32_2_switch\stm32f4xx_hal_msp.o"
"stm32_2_switch\stm32f4xx_hal_rcc.o"
"stm32_2_switch\stm32f4xx_hal_rcc_ex.o"
"stm32_2_switch\stm32f4xx_hal_flash.o"
"stm32_2_switch\stm32f4xx_hal_flash_ex.o"
"stm32_2_switch\stm32f4xx_hal_flash_ramfunc.o"
"stm32_2_switch\stm32f4xx_hal_gpio.o"
"stm32_2_switch\stm32f4xx_hal_dma_ex.o"
"stm32_2_switch\stm32f4xx_hal_dma.o"
"stm32_2_switch\stm32f4xx_hal_pwr.o"
"stm32_2_switch\stm32f4xx_hal_pwr_ex.o"
"stm32_2_switch\stm32f4xx_hal_cortex.o"
"stm32_2_switch\stm32f4xx_hal.o"
"stm32_2_switch\stm32f4xx_hal_exti.o"
"stm32_2_switch\system_stm32f4xx.o"
--strict --scatter "STM32_2_SWITCH\STM32_2_SWITCH.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "STM32_2_SWITCH.map" -o STM32_2_SWITCH\STM32_2_SWITCH.axf