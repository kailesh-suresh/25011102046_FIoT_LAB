--cpu Cortex-M3
"wemos_10a\startup_stm32f103xb.o"
"wemos_10a\main.o"
"wemos_10a\stm32f1xx_it.o"
"wemos_10a\stm32f1xx_hal_msp.o"
"wemos_10a\stm32f1xx_hal_gpio_ex.o"
"wemos_10a\stm32f1xx_hal_uart.o"
"wemos_10a\stm32f1xx_hal.o"
"wemos_10a\stm32f1xx_hal_rcc.o"
"wemos_10a\stm32f1xx_hal_rcc_ex.o"
"wemos_10a\stm32f1xx_hal_gpio.o"
"wemos_10a\stm32f1xx_hal_dma.o"
"wemos_10a\stm32f1xx_hal_cortex.o"
"wemos_10a\stm32f1xx_hal_pwr.o"
